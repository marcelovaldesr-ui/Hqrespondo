{
  "name": "Outbound V1 - Workflow C: Reply Detector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "node-reply-cron",
      "name": "Cron Cada 10 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HQ_BASE_URL || 'http://localhost:3000' }}/api/outbound/replies/check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-hq-token",
              "value": "={{ $env.HQ_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 45000
        }
      },
      "id": "node-check-replies",
      "name": "Consultar Respuestas en HQ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-replies",
              "leftValue": "={{ $json.respuestas_procesadas }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-replies",
      "name": "¿Hay Respuestas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📬 <b>Respuesta recibida en prospección</b>\n\nTotal procesadas: {{ $json.respuestas_procesadas }}\nSecuencias detenidas inmediatamente para evitar envíos automáticos posteriores.",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "node-telegram-alert",
      "name": "Alerta Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 280]
    }
  ],
  "connections": {
    "Cron Cada 10 Minutos": {
      "main": [
        [
          {
            "node": "Consultar Respuestas en HQ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar Respuestas en HQ": {
      "main": [
        [
          {
            "node": "¿Hay Respuestas?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hay Respuestas?": {
      "main": [
        [
          {
            "node": "Alerta Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
