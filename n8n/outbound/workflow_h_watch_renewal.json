{
  "name": "Outbound V1 - Workflow H: Gmail Watch Daily Renewal",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * *"
            }
          ]
        }
      },
      "id": "node-watch-cron",
      "name": "Cron Diario 04:00 CLT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HQ_BASE_URL || 'http://localhost:3000' }}/api/outbound/watch/renew",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-hq-token",
              "value": "={{ $env.HQ_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "node-renew-watches",
      "name": "Renovar Watches en HQ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-needs-intervention",
              "leftValue": "={{ $json.requiere_intervencion }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "cond-not-healthy",
              "leftValue": "={{ $json.estado_general }}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "node-if-watch-alert",
      "name": "¿Alerta o Falla en Watch?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⚠️ <b>Alerta de Suscripción Gmail Watch — Outbound V1</b>\n\nEstado General: <b>{{ $json.estado_general.toUpperCase() }}</b>\nBuzones Renovados: {{ $json.renovados.join(', ') || 'Ninguno' }}\nFallas: {{ $json.fallidos.length }}\n\n<b>Diagnóstico:</b>\n{{ $json.diagnosticos.map(d => '• ' + d.mailboxEmail + ': ' + d.mensaje).join('\n') }}\n\n<i>Acción requerida: Verificar tokens OAuth o Google Pub/Sub si hay estado crítico.</i>",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "node-watch-alert",
      "name": "Alerta Telegram Watch",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 280]
    }
  ],
  "connections": {
    "Cron Diario 04:00 CLT": {
      "main": [
        [
          {
            "node": "Renovar Watches en HQ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Renovar Watches en HQ": {
      "main": [
        [
          {
            "node": "¿Alerta o Falla en Watch?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Alerta o Falla en Watch?": {
      "main": [
        [
          {
            "node": "Alerta Telegram Watch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
